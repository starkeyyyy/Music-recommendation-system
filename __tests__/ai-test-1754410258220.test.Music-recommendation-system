// File: test/recommend.test.js
import axios from 'axios';
import { render, fireEvent, waitFor } from '@testing-library/react';
import { RecoilRoot } from 'recoil';
import App from '../App';

jest.setTimeout(10000);

describe('POST /recommend endpoint test', () => {
  it('should return recommended songs', async () => {
    const token = await getSpotifyToken();
    const songName = 'song_name';
    const response = await axios.post('http://localhost:5000/recommend', {
      song_name: songName,
    });
    expect(response.status).toBe(200);
    expect(response.data.songs).not.toBeNull();
  });

  it('should return error if song name is empty', async () => {
    const response = await axios.post('http://localhost:5000/recommend', {});
    expect(response.status).toBe(400);
    expect(response.data.error).toBe('Song name is required');
  });

  it('should return error if song name is not found', async () => {
    const token = await getSpotifyToken();
    const songName = 'not_found_song';
    const response = await axios.post('http://localhost:5000/recommend', {
      song_name: songName,
    });
    expect(response.status).toBe(200);
    expect(response.data.message).toContain('not found');
  });
});

async function getSpotifyToken() {
  const authStr = process.env.SPOTIFY_CLIENT_ID + ':' + process.env.SPOTIFY_CLIENT_SECRET;
  const b64AuthStr = Buffer.from(authStr, 'utf-8').toString('base64');
  const headers = {
    'Authorization': 'Basic ' + b64AuthStr,
  };
  const data = {
    'grant_type': 'client_credentials',
  };

  const response = await axios.post('https://accounts.spotify.com/api/token', data, { headers });
  return response.data.access_token;
}
